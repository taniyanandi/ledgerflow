meta {
  name: 2. Retry same payment (same key)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idempotency_key}}
}

body:json {
  {
    "merchantReference": "order-42",
    "amountMinor": 150000,
    "currency": "INR"
  }
}

docs {
  Same key + same body replays the original response (no new payment).
  Same key + different body returns 409 Conflict. Missing key returns 400.
}
